# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aluguei
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible; baseline Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=aluguei-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AI providers (the product runtime, not OpenCode itself)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=mock

# Google
GOOGLE_MAPS_API_KEY=

# Meta platform
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_MODE=dry_run

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Credit/screening providers
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
SPC_CLIENT_ID=
SPC_CLIENT_SECRET=

# Signature
CLICKSIGN_API_TOKEN=
D4SIGN_API_TOKEN=

# Payments
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
