# Configuração do Aluguei.app para desenvolvimento local. Copie para `.env` (nunca versionado).
# Schema e regras de produção: packages/config/src/env.ts e runtime.ts. O teste
# packages/config/src/env-example.test.ts exige as mesmas chaves aqui e no schema.
# Segredos ficam vazios: na homologação vêm do Coolify (docs/DEPLOY_COOLIFY.md).

# --- Processo ---
# Obrigatório para API e worker, sem padrão: development | test | production.
NODE_ENV=development
LOG_LEVEL=info
# Em produção, FAKE, mock e dry_run só sobem com ALLOW_FAKE_PROVIDERS=true (homologação).
ALLOW_FAKE_PROVIDERS=

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# URL do web. Em produção é obrigatória e https.
APP_BASE_URL=http://localhost:3000
# Origens do CORS separadas por vírgula; vazio: APP_BASE_URL.
CORS_ORIGINS=
SESSION_TTL_SECONDS=2592000
# Vazio: cookie Secure só em produção. Produção recusa false.
COOKIE_SECURE=
# E-mails dos admins da plataforma, separados por vírgula; vazio: ninguém acessa /plataforma.
PLATFORM_ADMIN_EMAILS=

# --- Web (Next.js) ---
# URL da API para o BFF. Em produção: https, ou http da rede interna com a permissão abaixo.
API_BASE_URL=http://localhost:4000
# true: aceita API_BASE_URL http em produção, só para endereço interno (ex.: http://api:4000).
API_BASE_URL_ALLOW_HTTP=
# Slug da imobiliária exibida na vitrine pública.
PUBLIC_ORG_SLUG=

# --- Worker ---
# Porta do health HTTP (GET /health: 200 com o loop saudável, 503 sem); vazio: sem health.
WORKER_HEALTH_PORT=
# Espera, em ms, pelos jobs em andamento no SIGTERM/SIGINT; vazio: 20000.
WORKER_SHUTDOWN_TIMEOUT_MS=

# --- Banco e cache ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aluguei
# Opcional: rate limit compartilhado entre instâncias da API (redis:// ou rediss://).
REDIS_URL=

# --- Storage (S3 compatível; R2 ou MinIO) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=aluguei-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true para MinIO atrás de domínio próprio (bucket no caminho).
STORAGE_FORCE_PATH_STYLE=

# --- IA (openai | gemini | mock) ---
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Google Maps (geocoding e Places) ---
GOOGLE_MAPS_API_KEY=

# --- Meta: WhatsApp e Meta Ads (live | dry_run) ---
META_MODE=dry_run
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Hex de 64 caracteres (32 bytes); obrigatória na API em produção.
META_TOKEN_ENCRYPTION_KEY=
# Organização permitida no servidor MCP da Meta.
MCP_ALLOWED_ORG_ID=

# --- WhatsApp (credenciais do modo live) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Crédito (SERASA | SPC | FAKE) ---
SCREENING_PROVIDER=FAKE
SCREENING_APPROVE_SCORE_MIN=
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
SPC_CLIENT_ID=
SPC_CLIENT_SECRET=

# --- Assinatura (CLICKSIGN | D4SIGN | FAKE) ---
SIGNATURE_PROVIDER=FAKE
SIGNATURE_WEBHOOK_TOKEN=
CLICKSIGN_API_TOKEN=
D4SIGN_API_TOKEN=

# --- Pagamentos (ASAAS | FAKE) ---
PAYMENT_PROVIDER=FAKE
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# --- Observabilidade ---
# URL base do coletor OTLP/HTTP (ex.: http://localhost:4318); vazio: sem spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
